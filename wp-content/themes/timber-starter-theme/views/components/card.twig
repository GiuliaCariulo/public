{% set category = get_terms()|first %}
<article class="card" data-type="{{category.name}}">
  <div class="card-infos">
    <address>{{post.author.display_name}}</address>
    <time datetime="2026-02-12">12.02.26</time>
  </div>
  <div class="card-container">
    <div class="card-content">
      <div>
        <h2>{{post.post_title}}</h2>
        <p>
          {{post.post_excerpt}}
        </p>
      </div>
      <a href="{{post.guid}}"> Lire l'article</a>
    </div>
    <div class="card-picture">
      {% if post.thumbnail.src %}
      <img src="{{ post.thumbnail.src }}" alt="image's description" />
      {% else  %}
      <div class="card-picture-placeholder"></div>
      {% endif %}
    </div>
  </div>
</article>


