<article class="card">
  <div class="card-infos">
    <address>Écrit par Ragekit</address>
    <time datetime="2026-02-12">12.02.26</time>
  </div>
  <div class="card-container">
    <div class="card-content">
      <div>
        <h2>{{post.post_title}}</h2>
        <p>
          {{post.meta('card-description')}}
        </p>
      </div>
      <a href="{{post.guid}}"> Lire l'article </a>
    </div>
    <div class="card-picture">
      <img src="{{ post.thumbnail.src }}" alt="image's description" />
    </div>
  </div>
</article>

