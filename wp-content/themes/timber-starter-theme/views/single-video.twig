{% extends "base.twig" %}

{% block content %}
<article class="article">
<section>
<img src="{{ post.thumbnail.src }}" alt="{{post.meta('card-description')}}">
<h1>{{post.post_title}}</h1>
{% include "components/author.twig" %}
{% include "components/date-parution.twig" %}
{% include "components/lecture-duree.twig" %}
{% include "components/media-duree.twig" %}
{{post.post_content}}
<br>
<a class="btn btn-secondary" href="{{post.meta('link_media')}}">Voir la vidéo</a>
</section>
{% include "components/closer.twig" %}
</article>
{% endblock %}
