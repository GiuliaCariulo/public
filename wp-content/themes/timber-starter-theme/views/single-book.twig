{% extends "base.twig" %}

{% block content %}
<article class="article">
          <h1>
            {{post.post_title}}
          </h1>
          <div class="article-infos-position-two">
            <div>
              <p class="article-hook">
                Du féminisme et des sciences humaines en BD
              </p>
              <div class="article-infos">
                <p class="article-info article-duration">
                  {% include "components/lecture-duree.twig" %}
                </p>
                
                <p class="article-info article-date">
                  {% include "components/date-parution.twig" %}
                </p>
                <br>
                <p class="article-info article-author">
                {% include "components/author.twig" %}  
                </p>
                <p class="article-info article-edition">
                  {% include "components/author.twig" %}
                </p>
                <p class="article-info article-edition">
                  {{post.meta('edition')}}
                </p>
              </div>
            </div>
            <img src="{{ post.thumbnail.src }}" alt="{{post.meta('card-description')}}" />
          </div>
          <div class="article-content">
          {{post.content}}
          </div>
        <section>
        <a class="btn btn-secondary" href="{{post.meta('link_media')}}">Commander le livre</a>
        </section>
        {% include "components/closer.twig" %}
        </article>
        {% include 'components/more-category.twig' %}
        {% include 'components/more-type.twig' %}
{% endblock %}
