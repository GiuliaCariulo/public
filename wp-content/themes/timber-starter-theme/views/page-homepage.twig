{% extends "base.twig" %}

{% block content %}
	<div class="content-wrapper">
		<article class="post-type-{{page.post_type}}" id="post-{{page.ID}}">
			<section class="article-content">
				<h1 class="article-h1">{{page.post_title}}</h1>
				{{page.post_content}}
				{{page.post_title}}
			</section>
		</article>
		{% include "components/filter.twig" %}
		<section class="cards-library">
		{% for post in posts %}
		{% include 'components/card.twig' %}
		{% endfor %}
		</section>
		{# {% include "components/header.twig" %} #}
		{% include "components/btn.twig" %}
		{% include "components/about.twig" %}
		{% include "components/contact.twig" %}
		{% include "components/month-hero.twig" %}
		{% include "components/support.twig" %}
		{# {% include "components/top.twig" %} #}
		{% include "components/article.twig" %}
	</div>
{% endblock %}
