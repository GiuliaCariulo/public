{% extends "base.twig" %}

{% block content %}
	<div class="content-wrapper">
		<article class="post-type-{{page.post_type}}" id="post-{{page.ID}}">
			<section class="article-content">
				<h1 class="article-h1">{{page.post_title}}</h1>
			</section>
		</article>
		<section class="cards-library">
		{% for post in posts %}
		{% include 'components/card.twig' %}
		{% endfor %}
		</section>
	</div>
{% endblock %}